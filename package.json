{
  "name": "namespace-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Documentation for Namespace ENS subname products and developer tools.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "mint dev",
    "validate": "mint validate",
    "check:links": "mint broken-links",
    "check:a11y": "mint a11y",
    "check:content": "node scripts/check-docs.mjs",
    "check:examples": "tsc --noEmit --project examples/tsconfig.json",
    "check": "npm run validate && npm run check:links && npm run check:a11y && npm run check:content && npm run check:examples"
  },
  "devDependencies": {
    "@thenamespace/mint-manager": "1.1.1",
    "@thenamespace/offchain-manager": "1.0.13",
    "@types/node": "22.20.1",
    "dotenv": "17.4.2",
    "mint": "4.2.694",
    "typescript": "6.0.3",
    "viem": "2.55.2"
  }
}
